{
  "name": "el-pais-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "prebuild": "node scripts/prepare.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "data:refresh": "python scripts/ingest.py --refresh"
  },
  "dependencies": {
    "lucide": "0.468.0",
    "maplibre-gl": "6.16.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "polygon-clipping": "0.15.7",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
